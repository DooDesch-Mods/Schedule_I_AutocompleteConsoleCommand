<Project>

  <!-- Your own machine's paths, gitignored. Optional: without it the defaults below are used. -->
  <Import Project="$(MSBuildThisFileDirectory)local.build.props"
          Condition="Exists('$(MSBuildThisFileDirectory)local.build.props')" />

  <PropertyGroup>
    <AssemblyName Condition="'$(MSBuildProjectName)' != 'ConsoleAutocomplete.Loader'">ConsoleAutocomplete</AssemblyName>
    <RootNamespace Condition="'$(MSBuildProjectName)' != 'ConsoleAutocomplete.Loader'">ConsoleAutocomplete</RootNamespace>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!--
      Where the game is. This project references the live install rather than a checked-in
      reference set, so the path has to exist on whatever machine is building.

      Order: an explicit -p:GameCorePath wins, then local.build.props (gitignored - put your own
      path there), then the default Steam locations below. Steam's own install path comes from the
      registry, so the common case needs no configuration at all.

      A single hardcoded path used to be the only option, and on any machine that did not match it
      the build produced 120+ "the type or namespace ScheduleOne does not exist" errors, which read
      like the game had changed rather than like a wrong path.
    -->
    <SteamPath Condition="'$(SteamPath)' == ''">$(registry:HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\Valve\Steam@InstallPath)</SteamPath>
    <GameCorePath Condition="'$(GameCorePath)' == '' AND '$(SteamPath)' != '' AND Exists('$(SteamPath)\steamapps\common\Schedule I\Schedule I.exe')">$(SteamPath)\steamapps\common\Schedule I</GameCorePath>
    <GameCorePath Condition="'$(GameCorePath)' == '' AND Exists('C:\Program Files (x86)\Steam\steamapps\common\Schedule I\Schedule I.exe')">C:\Program Files (x86)\Steam\steamapps\common\Schedule I</GameCorePath>
    <GameCorePath Condition="'$(GameCorePath)' == '' AND Exists('D:\SteamLibrary\steamapps\common\Schedule I\Schedule I.exe')">D:\SteamLibrary\steamapps\common\Schedule I</GameCorePath>
    <GameCorePath Condition="'$(GameCorePath)' == '' AND Exists('E:\SteamLibrary\steamapps\common\Schedule I\Schedule I.exe')">E:\SteamLibrary\steamapps\common\Schedule I</GameCorePath>
    <MelonLoaderPath>$(GameCorePath)\MelonLoader</MelonLoaderPath>
    <Il2CppAssembliesPath>$(MelonLoaderPath)\Il2CppAssemblies</Il2CppAssembliesPath>
  </PropertyGroup>

  <!-- Debug builds: verbose Melon console tracing for autocomplete. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);AUTOCOMPLETE_DEBUG</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'ConsoleAutocomplete.Loader'">
    <Compile Include="src\**\*.cs" Exclude="src\Util\GameTypes\GlobalUsings.IL2CPP.cs;src\Util\GameTypes\GlobalUsings.Mono.cs" />
  </ItemGroup>
</Project>
